generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model users {
  id       Int    @id @default(autoincrement())
  name     String @db.VarChar(100)
  email    String @unique(map: "email") @db.VarChar(150)
  password String @db.VarChar(255)
}

model maestros {
  id             Int    @id @default(autoincrement())
  nombre         String @db.VarChar(100)
  apellido       String @db.VarChar(100)
  numeroEmpleado String @unique(map: "numeroEmpleado") @db.VarChar(50)
  departamento   String @db.VarChar(100)
  correo         String @unique(map: "correo") @db.VarChar(150)
}

model alumnos {
  id           Int    @id @default(autoincrement())
  nombre       String @db.VarChar(100)
  apellido     String @db.VarChar(100)
  matricula    String @unique(map: "matricula") @db.VarChar(50)
  carrera      String @db.VarChar(100)
  cuatrimestre String @db.VarChar(50)
  correo       String @unique(map: "correo") @db.VarChar(150)
}
